{
  "name": "sistema-autorizacion-personal",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de gestión y autorización de personal externo para locales de un shopping.",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace backend",
    "dev:front": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend && npm run build --workspace backend",
    "start": "npm run start --workspace backend",
    "migrate": "npm run migrate --workspace backend",
    "seed": "npm run seed --workspace backend",
    "test": "npm run test --workspace backend",
    "backup": "node scripts/backup.mjs",
    "ocr:download": "node scripts/descargar-ocr.mjs"
  },
  "engines": {
    "node": "20.x || 22.x || 23.x || 24.x"
  },
  "dependencies": {
    "better-sqlite3": "~12.4.1"
  }
}

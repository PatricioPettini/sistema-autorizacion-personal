# =====================================================================
#  Sistema de Autorización de Personal — Archivo de ejemplo
#  Copiá este archivo como  .env  y completá los valores.
#  NUNCA subas el archivo .env real al repositorio.
# =====================================================================

# --- Servidor ---
PORT=4000
HOST=127.0.0.1
NODE_ENV=development

# Secreto para firmar sesiones. Generá uno largo y aleatorio.
# En Windows PowerShell:  [guid]::NewGuid().ToString()  (usá varios juntos)
SESSION_SECRET=cambiame-por-un-secreto-largo-y-aleatorio

# --- Almacenamiento ---
# Carpeta donde se guardan la base de datos y los documentos.
# Puede ser relativa al proyecto o una ruta absoluta de Windows.
STORAGE_PATH=./storage

# --- Zona horaria / localización ---
TZ=America/Argentina/Buenos_Aires
LOCALE=es-AR

# --- Email: RECEPCIÓN (IMAP) ---
# La casilla del sistema vive SOLO acá (o en los secretos de fly): no se edita desde el panel.
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_IMAP_SECURE=true
MAIL_IMAP_USER=
MAIL_IMAP_PASSWORD=

# --- Email: ENVÍO (SMTP) ---
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_SECURE=false
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
MAIL_FROM_NAME=Seguridad Shopping
MAIL_FROM_ADDRESS=

# --- Procesamiento automático de emails ---
# Frecuencia de revisión del buzón, en minutos. 0 = desactivado.
MAIL_POLL_MINUTES=5
# Mover emails procesados a una carpeta (vacío = no mover).
MAIL_PROCESSED_FOLDER=
# Los correos ANTERIORES a esta fecha (YYYY-MM-DD) se ingresan pero quedan en el RESPALDO para
# revisarlos a mano, en vez de procesarse solos. Es para arrancar después de una caída del correo:
# lo que llegó mientras el sistema no leía el buzón puede haberse cargado a mano y procesarlo
# duplicaría la solicitud. Vacío = todo se procesa normalmente.
MAIL_REVISAR_ANTES_DE=

# --- Reglas de negocio ---
# Días de anticipación para avisar vencimientos.
EXPIRY_ALERT_DAYS=15
# Tamaño máximo de adjunto/archivo permitido (MB).
MAX_FILE_MB=25
# Tamaño máximo total descomprimido de un ZIP (MB) — protección anti ZIP-bomb.
MAX_ZIP_UNCOMPRESSED_MB=200

# --- OCR ---
# Idioma(s) Tesseract. spa = español.
OCR_LANGS=spa
